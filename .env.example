# Copy to .env and adjust only for your deployment.
PORT=3000
HOST=127.0.0.1

# Optional: protects API routes when configured. Generate your own random secret.
# Required when binding HOST to a non-loopback interface.
# Generate a 256-bit token in PowerShell:
# $b=New-Object byte[] 32; $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); [BitConverter]::ToString($b).Replace('-','').ToLower()
API_TOKEN=

# Optional threat-intelligence integrations. A URL is shared only after per-scan consent.
# Google Safe Browsing is enabled only when both variables are set. Its API is for
# non-commercial use; commercial use should use Google Web Risk under its terms.
# Get a key and enable the API: https://developers.google.com/safe-browsing/v4/get-started
# Review terms and usage limits before enabling:
# https://developers.google.com/safe-browsing/v4/terms
# https://developers.google.com/safe-browsing/v4/usage-limits
GOOGLE_SAFE_BROWSING_ENABLED=false
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal's public API is rate-limited. URLs submitted or queried may be added
# to its dataset and made available to the community; never send confidential URLs.
# Get your key: https://www.virustotal.com/gui/my-apikey
# API documentation: https://docs.virustotal.com/reference/scan-url
VIRUSTOTAL_API_KEY=

# URLhaus requires an Auth-Key. Its community API is subject to fair-use terms.
# Commercial/for-profit usage may require its paid API.
# Create an Auth-Key: https://auth.abuse.ch/
# https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=

# Optional PhishTank provider. Register for an app key for higher request limits:
# https://phishtank.org/api_register.php
PHISHTANK_APP_KEY=
PHISHTANK_ENABLED=false

# Optional local persistence directory (default: ./data)
# DATA_DIR=
